# Copy to ".env" in the repo root for real credentials.
# If this file is missing, the API still starts using built-in dev placeholders
# in app/core/config.py (login and features need a real DATABASE_URL, etc.).

# ---- Core ----
ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

# ---- Database (Neon Postgres) ----
# For local Postgres without TLS, append ?sslmode=disable (avoids SSL negotiation errors on Windows).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
# Local example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# ---- Redis queue (Upstash) ----
UPSTASH_REDIS_URL=rediss://default:password@host:port

# ---- Supabase Storage ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_BUCKET=handouts

# ---- Groq AI ----
GROQ_API_KEY=your-groq-key
GROQ_VLM_MODEL=llama-3.2-90b-vision-preview
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---- Limits / tuning (override defaults only if needed) ----
# MAX_UPLOAD_BYTES=20971520
# CHAT_RATE_LIMIT_PER_MINUTE=10
# ANALYTICS_CACHE_SECONDS=3600
